{
  "name": "delphi-pugh",
  "private": true,
  "version": "0.1.0",
  "description": "Offline research app for a two-round modified Delphi and Pugh concept selection (thesis: lead apron-supporting passive exoskeleton).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:excel": "bash tools/excel-verify/run.sh"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vazirmatn": "^33.0.3",
    "xlsx": "0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
